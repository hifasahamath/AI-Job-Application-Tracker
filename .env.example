# ==========================================
# AI JOB APPLICATION TRACKER ENVIRONMENT
# ==========================================

# ------------------------------------------
# Server & CORS Configuration
# ------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Database Configuration (Supabase or Local PostgreSQL)
# ------------------------------------------
# For Supabase: jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres
# For Local Docker Compose / PostgreSQL: jdbc:postgresql://localhost:5432/jobtracker
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobtracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
POSTGRES_DB=jobtracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------
# JWT Security Configuration
# ------------------------------------------
# Base64-encoded 256-bit secret key (min 32 bytes)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtbG9uZy1qd3Qtc2VjcmV0LWtleS1mb3ItYWktam9iLXRyYWNrZXItYXBwbGljYXRpb24=
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# ------------------------------------------
# Supabase Storage Configuration (Profile Avatars)
# ------------------------------------------
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=profile-pictures

# ------------------------------------------
# Frontend API Gateway URL Configuration
# ------------------------------------------
# Direct Spring Boot URL (Local Dev):
NEXT_PUBLIC_API_URL=http://localhost:8080

# WSO2 API Platform Cloud Gateway URL (Production / Demo):
# NEXT_PUBLIC_API_URL=https://api.cloud.wso2.com/t/jobtracker/v1
